# 复制本文件为 .env，填入真实值。.env 已被 .gitignore 排除，不会进版本库。
# 只要服务商兼容 OpenAI 的 /v1/chat/completions，前三项就够了。

# ---------- 大模型 ----------
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 可选：限制输出长度。部分新模型（如 o1 系列）不接受该字段，留空即不传
LLM_MAX_TOKENS=

# 可选：429 / 5xx 时的最大重试次数，默认 3（指数退避 1s→2s→4s）
LLM_MAX_RETRIES=3

# 可选：自定义 User-Agent。部分网关（如 OpenCode Go）会校验
LLM_USER_AGENT=ragxuexi/0.1

# 可选：固定会话 ID。部分网关要求 x-opencode-session 头，固定它可命中服务端 prompt 缓存；
# 留空则每次进程启动生成新的 uuid
LLM_SESSION_ID=

# ---------- 检索 ----------
# 召回数量：进入 Prompt 的 chunk 数
RAG_TOP_K=2

# 最低相似度：得分不高于此值的文档不进 Prompt。
# 注意：余弦分数随语料和模型漂移，这个值必须用评测集标定，别拍脑袋
RAG_MIN_SCORE=0

# ---------- Embedding ----------
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 模型下载走镜像（huggingface.co 在多数国内网络不可达），代码里已默认设置 HF_ENDPOINT
# HF_ENDPOINT=https://hf-mirror.com
